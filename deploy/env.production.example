APP_NAME=Arezoo
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # php artisan key:generate
APP_URL=https://api.example.ir
APP_LOCALE=fa

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arezoo
DB_USERNAME=arezoo
DB_PASSWORD=                  # رمز قوی

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.example.ir    # نقطه اول مهم است
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true

FRONTEND_URL=https://example.ir
SANCTUM_STATEFUL_DOMAINS=example.ir

SMS_DRIVER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=verify
